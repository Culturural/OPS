{
  "productName": "OPS Recorder",
  "version": "0.1.0",
  "identifier": "com.ops.recorder",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
